; Engine configuration file.
; Spec: CLAUDE.md
;
; Tycoon Engine — standalone, theme-agnostic.
; This project ships the addon `addons/tycoon_core/` plus tests and example
; content. No theme-specific logic lives here (see CLAUDE.md §1).

config_version=5

[application]

config/name="Tycoon Engine"
config/description="Standalone, theme-agnostic tycoon simulation engine."
run/main_scene=""
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Order matters — earlier autoloads are available to later ones.
EventBus="*res://addons/tycoon_core/autoload/event_bus.gd"
SimClock="*res://addons/tycoon_core/autoload/sim_clock.gd"
Ledger="*res://addons/tycoon_core/autoload/ledger.gd"
ContentDB="*res://addons/tycoon_core/autoload/content_db.gd"
EntityRegistry="*res://addons/tycoon_core/autoload/entity_registry.gd"
RegionRegistry="*res://addons/tycoon_core/autoload/region_registry.gd"
NavigationRegistry="*res://addons/tycoon_core/autoload/navigation_registry.gd"
AgentPool="*res://addons/tycoon_core/autoload/agent_pool.gd"
EffectResolver="*res://addons/tycoon_core/autoload/effect_resolver.gd"
ProgressionManager="*res://addons/tycoon_core/autoload/progression_manager.gd"
Accounting="*res://addons/tycoon_core/autoload/accounting.gd"
SaveService="*res://addons/tycoon_core/autoload/save_service.gd"

[editor_plugins]

; GUT plugin not enabled by default — its editor dock uses Godot 4.4+ APIs
; (`EditorDock`, `add_dock`/`remove_dock`). On 4.4+ you can enable it via
; Project > Project Settings > Plugins. CLI test runs use gut_cmdln.gd directly
; and don't need the plugin loaded.
enabled=PackedStringArray()

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
